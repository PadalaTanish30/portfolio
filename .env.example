# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development.
# On Vercel, add these under Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# Public production URL (used for metadata, sitemap, RSS, OG images)
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app

# Optional: X/Twitter handle for card metadata (with the @)
NEXT_PUBLIC_TWITTER_HANDLE=

# --- Anime / Manga auto-sync ------------------------------------------------
# Set your AniList username to auto-sync BOTH your anime and manga lists.
# Free, public API — no key required. Leave blank to use the local fallback
# files (src/data/anime.ts, src/data/manga.ts).
ANILIST_USERNAME=

# Optional alternative: MyAnimeList username (synced via the free Jikan API).
# Used only when ANILIST_USERNAME is empty or its sync fails.
MAL_USERNAME=
